# Copy to .env. Defaults run locally against the Postgres from docker-compose and embedded Qdrant.

# --- Identity database (Postgres, schema "auth") ---
# DATABASE_URL=postgresql+psycopg://policy:policy@localhost:5432/policy_copilot
# AUTO_MIGRATE=true            # run Alembic migrations at startup
# SEED_DEMO_USERS=true         # alice/mark/hannah/carl/root, only when the users table is empty. Set false outside local dev.

# --- JWT ---
# JWT_SECRET=<long random string>   # REQUIRED outside local dev: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# PASSWORD_MIN_LENGTH=10

# --- Vector store ---
# Use the Qdrant server from docker-compose instead of embedded storage
# QDRANT_URL=http://localhost:6333

# --- Models ---
# GOOGLE_API_KEY=            # enables the Gemini options (GEMINI_API_KEY also works). Cloud: question and retrieved text go to Google.
# OLLAMA_BASE_URL=http://localhost:11434
# MODELS_CONFIG=./models.json
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval (see docs/phase2-retrieval-evaluation.md) ---
# RERANKER_PROVIDER=fastembed         # fastembed | overlap | none (default fastembed: measured +13 points)
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_FETCH_K=10
# MIN_RERANK_SCORE=0.001              # relevance threshold when reranking; re-tune with: python -m app.eval
# MIN_RETRIEVAL_SCORE=0.45            # relevance threshold without a reranker (cosine similarity)
# RETRIEVAL_MODE=dense                # dense | hybrid (BM25 + dense, opt-in). Changing it needs: python -m app.rag.manage reindex
