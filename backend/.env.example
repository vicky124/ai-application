# Copy to .env. All values are optional; defaults run fully local with embedded Qdrant.

# Use the Qdrant server from docker-compose instead of embedded storage
# QDRANT_URL=http://localhost:6333

# Ollama endpoint for open-source LLMs (llama3.1, qwen2.5, mistral)
# OLLAMA_BASE_URL=http://localhost:11434

# Config-level model list: JSON file with [{id,label,provider,name,default}, ...]
# MODELS_CONFIG=./models.json

# Embeddings (fixed per collection): fastembed | hash
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# JWT_SECRET=change-me
